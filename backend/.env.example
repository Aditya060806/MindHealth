# MindHealth Backend Environment Template (.env)

# Database Configuration (Zero-configuration local SQLite by default)
DATABASE_URL=sqlite:///./mindcare.db

# Random 32+ character JWT secret
JWT_SECRET=your_super_secret_jwt_random_key_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key for Counselling Chat & AI Insights (Step 2)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# OpenRouter (Fallback provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
